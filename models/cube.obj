# 정점 위치 (Vertices)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5

# UV 텍스처 좌표 (TexCoords)
vt 0.0 1.0
vt 1.0 1.0
vt 0.0 0.0
vt 1.0 0.0

# 법선 벡터 (Normals)
vn  0.0  0.0  1.0
vn  1.0  0.0  0.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# 면 구성 (Faces) - v/vt/vn 순서로 결합됨
# 앞면
f 1/1/1 2/2/1 3/3/1
f 2/2/1 4/4/1 3/3/1
# 오른쪽면
f 2/1/2 6/2/2 4/3/2
f 6/2/2 8/4/2 4/3/2
# 뒷면
f 6/1/3 5/2/3 8/3/3
f 5/2/3 7/4/3 8/3/3
# 왼쪽면
f 5/1/4 1/2/4 7/3/4
f 1/2/4 3/4/4 7/3/4
# 윗면
f 3/1/5 4/2/5 7/3/5
f 4/2/5 8/4/5 7/3/5
# 아랫면
f 5/1/6 6/2/6 1/3/6
f 6/2/6 2/4/6 1/3/6